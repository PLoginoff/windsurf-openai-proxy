{
  "name": "windsurf-openai-proxy",
  "version": "0.2.0",
  "description": "Use Windsurf/Cognition/Devin models (Claude, GPT, Gemini, Kimi, SWE) in Zed, Cline or any client — one zero-dep proxy speaking OpenAI, Ollama and llama.cpp protocols, with cost tiers, power ranks and multi-key access built in",
  "author": "ploginoff",
  "contributors": [
    "Ken Taylor (original pi-windsurf)"
  ],
  "license": "MIT",
  "keywords": [
    "windsurf",
    "devin",
    "codeium",
    "cognition",
    "zed",
    "cline",
    "ollama",
    "llama-cpp",
    "openai-compatible",
    "llm-proxy",
    "claude",
    "gemini",
    "self-hosted",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ploginoff/windsurf-openai-proxy.git"
  },
  "bin": {
    "windsurf-openai-proxy": "./cli.ts"
  },
  "scripts": {
    "serve": "npx tsx cli.ts serve",
    "login": "npx tsx cli.ts login",
    "status": "npx tsx cli.ts status",
    "logout": "npx tsx cli.ts logout",
    "models": "npx tsx cli.ts models",
    "recommend": "npx tsx cli.ts recommend",
    "probe": "npx tsx cli.ts probe"
  },
  "files": [
    "*.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
